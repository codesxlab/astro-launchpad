---
import type { IconName } from '../../types/config';

interface Props {
  name: IconName;
  class?: string;
  strokeWidth?: number;
}

interface IconDef {
  body: string;
  strokeWidth?: number;
  /** Filled 16px glyph instead of a 24px stroke icon. */
  filled?: boolean;
  linejoin?: boolean;
}

const ICONS: Record<IconName, IconDef> = {
  arrow: { body: '<path d="M5 12h14M13 6l6 6-6 6"/>', strokeWidth: 2 },
  'check-circle': { body: '<circle cx="12" cy="12" r="9"/><path d="m8 12 2.7 2.7L16.5 9"/>', strokeWidth: 2 },
  mail: { body: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/>' },
  cpu: {
    body: '<rect x="6" y="6" width="12" height="12" rx="2"/><path d="M9 2v4m6-4v4M9 18v4m6-4v4M2 9h4m-4 6h4m12-6h4m-4 6h4"/>',
    strokeWidth: 1.7,
  },
  bolt: { body: '<path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"/>' },
  terminal: { body: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="m7 9 3 3-3 3m5 0h5"/>' },
  window: { body: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M8 4v5"/>' },
  file: {
    body: '<path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6M8 13h8M8 17h5"/>',
  },
  pen: { body: '<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/>' },
  code: { body: '<path d="m16 18 6-6-6-6M8 6l-6 6 6 6"/>' },
  chat: { body: '<path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12Z"/>' },
  menu: { body: '<path d="M4 7h16M4 12h16M4 17h16"/>', linejoin: false },
  github: {
    filled: true,
    body: '<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>',
  },
};

const { name, class: className, strokeWidth } = Astro.props;
const icon = ICONS[name];
---

{
  icon.filled ? (
    <svg class={className} viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" set:html={icon.body} />
  ) : (
    <svg
      class={className}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width={strokeWidth ?? icon.strokeWidth ?? 1.8}
      stroke-linecap="round"
      stroke-linejoin={icon.linejoin === false ? undefined : 'round'}
      aria-hidden="true"
      set:html={icon.body}
    />
  )
}
