---
import type { WorkflowDemoConfig } from '../../types/config';
import { escapeHtml } from '../../lib/text';
import Chip from '../ui/Chip.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  demo: WorkflowDemoConfig;
}

const { demo } = Astro.props;

// Pretty-printed JSON with highlighted keys and values.
const json =
  '{\n' +
  demo.output.fields
    .map(
      ([key, value]) =>
        `  <span class="k">"${escapeHtml(key)}"</span>: <span class="v">"${escapeHtml(value)}"</span>`,
    )
    .join(',\n') +
  '\n}';
---

<div class="panel">
  <div class="panel-top">
    <div class="dots" aria-hidden="true"><i></i><i></i><i></i></div>
    <span>{demo.windowTitle}</span>
    <Chip>{demo.badge}</Chip>
  </div>
  <!-- Renders the final stage by default, so the demo makes sense without JS. -->
  <div class="panel-body" id="demo" data-stage="4">
    <div class="demo-progress" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
    <div>
      <div class="demo-label"><Icon name="mail" />{demo.input.label}</div>
      <p class="demo-input" id="demoInput">{demo.input.text}</p>
    </div>
    <div class="demo-ai">
      <span class="ai-icon"><Icon name="cpu" /></span>
      <span>
        <strong>{demo.ai.title}</strong>
        <small>
          <span class="st st-wait">{demo.ai.waiting}</span><span class="st st-run">{demo.ai.running}</span><span
            class="st st-done">{demo.ai.done}</span>
        </small>
      </span>
      <Chip tone="blue">{demo.ai.badge}</Chip>
    </div>
    <div class="code demo-out">
      <div class="code-head"><span>{demo.output.fileName}</span><span>{demo.output.note}</span></div>
      <pre set:html={json} />
    </div>
    <div class="demo-review">
      <span><strong>{demo.review.title}</strong><small>{demo.review.note}</small></span>
      <Chip tone="amber" class="rv-wait">{demo.review.pending}</Chip><Chip tone="green" class="rv-ok"
        >{demo.review.approved}</Chip>
    </div>
  </div>
</div>
<p class="visual-note">{demo.caption}</p>

<script>
  // Hero workflow demo: type → process → structured output → approval, then loop.
  const demo = document.getElementById('demo');
  const input = document.getElementById('demoInput');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (demo && input && !reduced) {
    const text = input.textContent ?? '';
    const typed = document.createElement('span');
    typed.className = 'typed';
    const rest = document.createElement('span');
    rest.className = 'rest';
    const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
    const visible = () => !document.hidden;

    const loop = async () => {
      input.textContent = '';
      input.append(typed, rest);
      for (;;) {
        demo.dataset.stage = '1';
        typed.textContent = '';
        rest.textContent = text;
        await wait(500);
        for (let i = 1; i <= text.length; i++) {
          typed.textContent = text.slice(0, i);
          rest.textContent = text.slice(i);
          await wait(26);
        }
        await wait(350);
        demo.dataset.stage = '2';
        await wait(1500);
        demo.dataset.stage = '3';
        await wait(1700);
        demo.dataset.stage = '4';
        await wait(3200);
        while (!visible()) await wait(500);
      }
    };
    loop();
  }
</script>

<style>
  .panel {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 24px;
    box-shadow: 0 40px 80px -40px rgba(13, 16, 23, .32), 0 2px 6px rgba(13, 16, 23, .04);
    overflow: hidden;
  }
  .panel-top {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--line);
    font: 500 12px var(--mono);
    color: var(--muted);
  }
  .dots { display: flex; gap: 6px; }
  .dots i { width: 10px; height: 10px; border-radius: 50%; background: #e1e2dd; }
  .panel-top :global(.chip) { margin-left: auto; }
  .panel-top > span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  .panel-body { padding: 22px 24px 24px; display: grid; gap: 14px; }

  .demo-label {
    display: flex;
    align-items: center;
    gap: 8px;
    font: 600 11px var(--mono);
    letter-spacing: .05em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 8px;
  }
  .demo-label :global(svg) { width: 15px; height: 15px; }
  .demo-input {
    margin: 0;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: 14px 14px 14px 4px;
    background: var(--bg);
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--ink);
  }
  /* `.typed` / `.rest` are created by the script, so they carry no scope. */
  .demo-input :global(.rest) { visibility: hidden; }
  .demo-input :global(.typed)::after {
    content: "";
    display: inline-block;
    width: 2px;
    height: 1em;
    margin-left: 1px;
    vertical-align: -2px;
    background: var(--accent);
    animation: blink 1s steps(1) infinite;
  }
  [data-stage="4"] .demo-input :global(.typed)::after,
  [data-stage="3"] .demo-input :global(.typed)::after { display: none; }

  .demo-ai {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) auto;
    gap: 12px;
    align-items: center;
    padding: 12px;
    border: 1px dashed var(--line2);
    border-radius: 14px;
  }
  .ai-icon {
    width: 44px;
    height: 44px;
    border-radius: 13px;
    display: grid;
    place-items: center;
    background: var(--accent);
    color: #fff;
    box-shadow: 0 0 0 5px var(--accent-soft);
  }
  .ai-icon :global(svg) { width: 20px; height: 20px; }
  [data-stage="2"] .ai-icon { animation: think 1s ease-in-out infinite; }
  @keyframes think { 50% { box-shadow: 0 0 0 10px rgba(51, 82, 255, .12); } }
  .demo-ai strong { display: block; font-size: 15px; font-weight: 600; line-height: 1.3; }
  .demo-ai small { display: block; font-size: 13px; color: var(--muted); line-height: 1.4; }
  .st { display: none; }
  [data-stage="1"] .st-wait,
  [data-stage="2"] .st-run,
  [data-stage="3"] .st-done,
  [data-stage="4"] .st-done { display: inline; }

  .code {
    background: var(--dark);
    border-radius: 14px;
    padding: 14px 16px;
    color: #d3d9e6;
    font: 12.5px/1.75 var(--mono);
    transition: opacity .45s ease, transform .45s ease;
  }
  .code-head { display: flex; justify-content: space-between; gap: 10px; color: #8b94a7; font-size: 11px; margin-bottom: 4px; }
  .code pre { margin: 0; font: inherit; white-space: pre-wrap; overflow-wrap: anywhere; }
  .code pre :global(.k) { color: #a9bdff; }
  .code pre :global(.v) { color: var(--lime); }
  [data-stage="1"] .demo-out,
  [data-stage="2"] .demo-out { opacity: .18; transform: translateY(6px); }

  .demo-review {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: 14px;
    transition: opacity .4s;
  }
  .demo-review strong { display: block; font-size: 14px; font-weight: 600; line-height: 1.3; }
  .demo-review small { display: block; font-size: 12.5px; color: var(--muted); }
  [data-stage="1"] .demo-review,
  [data-stage="2"] .demo-review { opacity: .45; }
  .demo-review :global(.rv-ok) { display: none; }
  [data-stage="4"] .demo-review :global(.rv-ok) { display: inline-block; }
  [data-stage="4"] .demo-review :global(.rv-wait) { display: none; }

  .demo-progress { display: flex; gap: 6px; }
  .demo-progress i { flex: 1; height: 3px; border-radius: 2px; background: var(--line); transition: background .3s; }
  [data-stage="1"] .demo-progress i:nth-child(-n+1),
  [data-stage="2"] .demo-progress i:nth-child(-n+2),
  [data-stage="3"] .demo-progress i:nth-child(-n+3),
  [data-stage="4"] .demo-progress i { background: var(--accent); }

  .visual-note { font: 12px/1.5 var(--mono); color: var(--muted); margin: 14px 0 0; text-align: center; }

  @media (max-width: 640px) {
    .panel-body { padding: 18px; }
    .demo-ai { grid-template-columns: 40px minmax(0, 1fr); }
    .demo-ai :global(.chip) { display: none; }
    .ai-icon { width: 40px; height: 40px; }
  }
  @media (max-width: 380px) {
    .code { font-size: 11.5px; padding: 12px; }
    .demo-review { flex-direction: column; align-items: flex-start; }
  }
</style>
