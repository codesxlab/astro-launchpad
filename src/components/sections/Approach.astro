---
import site from '../../site.config';
import { pad } from '../../lib/text';
import SectionHead from '../ui/SectionHead.astro';

const { approach } = site;
---

<section class="section approach" id="approach" aria-labelledby="approach-title">
  <div class="wrap">
    <SectionHead heading={approach.heading} titleId="approach-title" />
    <div class="steps">
      {
        approach.steps.map((step, i) => (
          <div class="step-card reveal">
            <span class="num">{pad(i + 1)} / {step.label}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </div>
        ))
      }
    </div>
    <div class="tech reveal">
      <span class="tech-label">{approach.tech.label}</span>
      <div class="tech-list">{approach.tech.items.map((item) => <span>{item}</span>)}</div>
    </div>
  </div>
</section>

<style>
  .approach {
    margin-inline: clamp(8px, 1.5vw, 20px);
    border-radius: 32px;
    background: var(--dark);
    color: #fff;
    position: relative;
    overflow: hidden;
  }
  .approach::before {
    content: "";
    position: absolute;
    width: 700px;
    height: 700px;
    left: -260px;
    top: -300px;
    background: radial-gradient(circle, rgba(51, 82, 255, .22), transparent 65%);
    pointer-events: none;
  }
  .approach .wrap { position: relative; }
  .approach :global(.eyebrow), .approach :global(.lead) { color: var(--dark-muted); }
  .approach :global(.eyebrow)::before { background: var(--lime); }

  .steps { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .step-card {
    padding: 26px;
    border: 1px solid var(--dark-line);
    border-radius: var(--radius);
    background: rgba(19, 24, 35, .8);
    transition: border-color .25s, transform .3s, opacity .7s ease, translate .7s ease;
  }
  .step-card:hover { border-color: #3a4458; transform: translateY(-4px); }
  .step-card .num { font: 600 12px var(--mono); letter-spacing: .06em; color: var(--lime); }
  .step-card h3 { font-size: 21px; margin: 30px 0 10px; }
  .step-card p { margin: 0; font-size: 14.5px; line-height: 1.7; color: var(--dark-muted); }

  .tech {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px 28px;
    margin-top: 44px;
    padding-top: 32px;
    border-top: 1px solid var(--dark-line);
  }
  .tech-label { font: 500 12px var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--dark-muted); }
  .tech-list { display: flex; flex-wrap: wrap; gap: 8px; }
  .tech-list span { padding: 8px 14px; border: 1px solid var(--dark-line); border-radius: 999px; font: 500 13px var(--mono); color: #dbe1ec; }

  @media (max-width: 1060px) {
    .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .steps { grid-template-columns: 1fr; }
    .approach { border-radius: 24px; }
  }
</style>
