---
import type { ConceptCardConfig } from '../../types/config';
import Chip from '../ui/Chip.astro';
import TerminalLines from '../ui/TerminalLines.astro';

interface Props {
  concept: ConceptCardConfig;
}

const { concept } = Astro.props;
const { visual } = concept;
---

<article class="work-card reveal">
  <div class:list={['work-media', concept.tone === 'dark' && 'dark']}>
    <span class="work-label">{concept.label}</span>
    {
      visual.type === 'dashboard' ? (
        <div class="mock-dash" role="img" aria-label={visual.ariaLabel}>
          <div class="md-top">
            <span>{visual.windowTitle}</span>
            <span class="dots" aria-hidden="true"><i /><i /><i /></span>
          </div>
          <div class="md-body">
            <div class="md-side"><i /><i /><i /><i /></div>
            <div class="md-main">
              <div class="md-title">{visual.heading}</div>
              <div class="md-stats">
                {visual.stats.map(([value, label]) => <div><b>{value}</b><small>{label}</small></div>)}
              </div>
              <div class="md-chart">
                {visual.bars.map((bar) => <i class:list={[bar.highlight && 'on']} style={`height:${bar.height}%`} />)}
              </div>
            </div>
          </div>
        </div>
      ) : (
        <div class="terminal" role="img" aria-label={visual.ariaLabel}>
          <div class="terminal-top">
            <span class="dots" aria-hidden="true"><i /><i /><i /></span>
            <span>{visual.windowTitle}</span>
            <span>{visual.shell}</span>
          </div>
          <div class="terminal-body">
            <TerminalLines lines={visual.lines} />
          </div>
        </div>
      )
    }
  </div>
  <div class="work-info">
    <div class="work-meta"><span>{concept.meta}</span><Chip tone="blue">{concept.badge}</Chip></div>
    <h3>{concept.title}</h3>
    <p>{concept.text}</p>
  </div>
</article>

<style>
  .work-card { overflow: hidden; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
  .work-media {
    position: relative;
    height: 340px;
    display: grid;
    place-items: center;
    padding: 56px 36px 36px;
    overflow: hidden;
    background: linear-gradient(155deg, #e9ecff 0%, #f6f6f3 70%);
  }
  .work-media.dark { background: linear-gradient(155deg, #18213a 0%, #0b0e14 70%); }
  .work-label {
    position: absolute;
    top: 18px;
    left: 18px;
    font: 500 11px var(--mono);
    letter-spacing: .04em;
    padding: 6px 11px;
    border-radius: 999px;
    background: rgba(255, 255, 255, .85);
    border: 1px solid var(--line);
    color: var(--ink2);
  }
  .work-media.dark .work-label { background: rgba(255, 255, 255, .06); border-color: #2c3446; color: #d2d8e4; }

  .dots { display: flex; gap: 6px; }
  .dots i { width: 10px; height: 10px; border-radius: 50%; background: #e1e2dd; }

  /* Dashboard mock */
  .mock-dash {
    width: min(100%, 440px);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 16px;
    box-shadow: 0 30px 60px -30px rgba(32, 54, 209, .35);
    overflow: hidden;
  }
  .md-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    font: 500 11px var(--mono);
    color: var(--muted);
  }
  .md-body { display: grid; grid-template-columns: 72px minmax(0, 1fr); }
  .md-side { padding: 14px 12px; border-right: 1px solid var(--line); background: #fafaf8; display: grid; gap: 10px; align-content: start; }
  .md-side i { display: block; height: 8px; border-radius: 4px; background: #e2e4de; }
  .md-side i:first-child { background: var(--accent); width: 70%; }
  .md-main { padding: 16px; }
  .md-title { font: 600 15px var(--display); letter-spacing: -.02em; }
  .md-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin: 12px 0; }
  .md-stats div { border: 1px solid var(--line); border-radius: 10px; padding: 9px 10px; min-width: 0; }
  .md-stats b { display: block; font: 600 19px var(--display); }
  .md-stats small {
    display: block;
    font: 500 9px var(--mono);
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: .03em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .md-chart { display: flex; align-items: flex-end; gap: 6px; height: 58px; padding-top: 6px; }
  .md-chart i { flex: 1; border-radius: 4px 4px 2px 2px; background: #d9defc; transform-origin: bottom; }
  .md-chart i.on { background: var(--accent); }
  :global(.js) .work-card.in .md-chart i { animation: grow .9s cubic-bezier(.2, .7, .2, 1) both; }
  .md-chart i:nth-child(2) { animation-delay: .05s !important; }
  .md-chart i:nth-child(3) { animation-delay: .1s !important; }
  .md-chart i:nth-child(4) { animation-delay: .15s !important; }
  .md-chart i:nth-child(5) { animation-delay: .2s !important; }
  .md-chart i:nth-child(6) { animation-delay: .25s !important; }
  .md-chart i:nth-child(7) { animation-delay: .3s !important; }
  .md-chart i:nth-child(8) { animation-delay: .35s !important; }
  @keyframes grow { from { transform: scaleY(.1); } }

  /* Terminal mock */
  .terminal {
    width: min(100%, 440px);
    background: #0f131b;
    border: 1px solid #2a3243;
    border-radius: 16px;
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, .7);
    overflow: hidden;
  }
  .terminal-top {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-bottom: 1px solid #222a39;
    font: 500 11px var(--mono);
    color: #8e98ab;
  }
  .terminal-top .dots i { background: #2b3342; }
  .terminal-top span:last-child { margin-left: auto; }
  .terminal-body { padding: 18px 18px 22px; font: 12px/1.95 var(--mono); color: #dce2ec; }

  .work-info { padding: 24px 28px 30px; }
  .work-meta { display: flex; align-items: center; justify-content: space-between; gap: 12px; font: 500 12px var(--mono); color: var(--muted); }
  .work-info h3 { font-size: clamp(23px, 2.1vw, 28px); margin: 16px 0 8px; }
  .work-info p { margin: 0; color: var(--muted); font-size: 15px; line-height: 1.7; max-width: 500px; }

  @media (max-width: 640px) {
    .work-media { height: 300px; padding: 68px 20px 24px; }
    .work-info { padding: 22px 22px 26px; }
    .md-body { grid-template-columns: 1fr; }
    .md-side { display: none; }
    .md-stats { gap: 6px; }
    .md-stats div { padding: 8px 7px; }
    .md-stats b { font-size: 17px; }
    .md-stats small { white-space: normal; overflow: visible; font-size: 8.5px; letter-spacing: 0; line-height: 1.3; }
  }
  @media (max-width: 380px) {
    .md-stats small { font-size: 7.5px; }
  }
  @media (max-width: 340px) {
    .md-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .md-stats div:nth-child(3) { display: none; }
  }
</style>
